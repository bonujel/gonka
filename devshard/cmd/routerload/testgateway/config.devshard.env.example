# config.devshard.env — TEMPLATE for a load-test gateway. Copy to
# config.devshard.env, fill secrets, then `chmod 600 config.devshard.env`.
# NEVER commit the filled-in file. Source: gonka.ai gateway quickstart (§2.2).

# --- Chain (public mainnet node; swap for a testnet node to avoid real ngonka) ---
export NODE_RPC=https://node3.gonka.ai/chain-rpc/
export CHAIN_ID="gonka-mainnet"
export NODE_BASE=https://node3.gonka.ai
export NODE_CHAIN_API=https://node3.gonka.ai/chain-api

# --- inferenced CLI (local only; not used by the container) ---
export INFERENCED_HOME="$HOME/.devshard-inferenced"
export INFERENCED_KEYRING="$INFERENCED_HOME/keyring-devshard"

# --- Escrow creator wallet + gateway auth (generate per §2.1) ---
# openssl rand -hex 32   -> DEVSHARD_PRIVATE_KEY (creator wallet; must be allowlisted)
# openssl rand -hex 24   -> DEVSHARD_API_KEYS    (this becomes ROUTER_API_KEY for routerload)
# openssl rand -hex 24   -> DEVSHARD_ADMIN_API_KEY
export DEVSHARD_PRIVATE_KEY=<64-char-hex-no-0x>
export DEVSHARD_API_KEYS=sk-<your-user-key>
export DEVSHARD_ADMIN_API_KEY=sk-admin-<your-admin-key>

# --- Gateway (devshardctl) ---
export DEVSHARD_INSTANCE_NAME=devshardctl-loadtest
# '[]' = multi-escrow POOL mode with no escrows yet; create them via admin API
# (RUNBOOK §B/§D). Pool mode is what production uses and what we A/B test.
export DEVSHARDS_JSON='[]'
export DEVSHARD_CHAIN_REST=https://node3.gonka.ai/chain-api
export DEVSHARD_TX_QUERY_REST=https://node3.gonka.ai/chain-api
export DEVSHARD_PUBLIC_API=https://node3.gonka.ai
export DEVSHARD_PORT=8080
export DEVSHARD_STORAGE_DIR=/root/.devshardctl
export DEVSHARD_STORAGE_HOST_DIR=.devshardctl
export DEVSHARD_MODEL=MiniMaxAI/MiniMax-M2.7

# --- THE LIMIT KNOBS UNDER TEST (this is where the customer's 429 is gated) ---
# Set these to MATCH PRODUCTION so your numbers are comparable. Ask the team
# for the prod values. GATEWAY_MAX_CONCURRENT_REQUESTS is the prime suspect for
# `rate limit exceeded: too many concurrent requests`.
export GATEWAY_MAX_CONCURRENT_REQUESTS=512   # concurrent in-flight cap (global, per gateway)
export GATEWAY_MAX_INPUT_TOKENS_IN_FLIGHT=0  # 0 = off; token-based in-flight cap
export GATEWAY_DEFAULT_MAX_TOKENS=3072
export GATEWAY_MAX_TOKENS_CAP=4096
export DEVSHARD_CAPACITY_AWARE_LIMITS=on     # dynamic cap by runtime capacity ("the cap is dynamic")

export DEVSHARD_TX_GAS_LIMIT=700000
export DEVSHARD_POC_REQUEST_MODE=relaxed
